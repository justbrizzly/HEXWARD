{
  "manifest_version": 3,
  "name": "Hexward — Web Vulnerability Scanner",
  "short_name": "Hexward",
  "version": "1.1.0",
  "description": "Flags web vulnerabilities, checks live CVE databases, maps findings to MITRE ATT&CK, NIST and CWE, and shows the fix.",
  "permissions": ["webRequest", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Hexward — scan this page",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" },
  "minimum_chrome_version": "110"
}
